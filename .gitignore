# Dependencies — restored with `npm install`, never committed.
node_modules/

# Build output — regenerated by `npm run build` / `npm run feature1:build`.
dist/
dist-feature1/

# Scratch space.
tmp/

# NOTE: output/ IS committed on purpose. Those are the canonical verified sample
# DXF/PDF/manifest — the evidence behind the Feature 1 acceptance claim, and the
# thing a reviewer looks at first. They are small and they matter.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local env
.env
.env.*
!.env.example

# Pinned per-package Python verifier env (bootstrapped by townhouse-demo npm test)
.venv/

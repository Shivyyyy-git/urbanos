{
  "name": "urbanos-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "feature1:dev": "vite --config feature1/vite.config.ts",
    "build": "tsc --noEmit && vite build",
